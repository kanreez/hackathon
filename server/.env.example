# Copy this file to server/.env and fill it in. Never commit server/.env.
# Share these values privately, the secret key gives full access to the database.

SUPABASE_URL=https://your-project-ref.supabase.co
# Secret key (sb_secret_...) or legacy service_role key. Server only, never in the app.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxx

# AI for the plain-language garage search. Tried first: "anthropic" (Claude), "gemini" or "openai".
# If it fails or times out, the server falls back to the others that have a key below
# (Claude -> Gemini Flash-Lite -> Gemini -> OpenAI). Fill in as many keys as you have; one is enough.
# Optional. The fast Gemini model tried before GEMINI_MODEL (Google keeps this alias current).
# GEMINI_LITE_MODEL=gemini-flash-lite-latest
AI_PROVIDER=anthropic

# Payments: "mock" (fake checkout with test cards, no real money). See server/payments/provider.js.
PAYMENT_PROVIDER=mock

# Anthropic key from https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-haiku-5-5
# ANTHROPIC_MODEL=claude-haiku-5-5

# OpenAI key from https://platform.openai.com/api-keys (paid: add a few dollars of credit first)
OPENAI_API_KEY=
# Optional. Any model ID from https://platform.openai.com/docs/models
# OPENAI_MODEL=gpt-5.4-mini

# Free Gemini key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Change if Google retires the default model (see the model list in AI Studio).
# GEMINI_MODEL=gemini-3.8-flash
# Optional. A second model to try when the main one is overloaded. Pick one from the model list in AI Studio.
# GEMINI_FALLBACK_MODEL=

PORT=3000
