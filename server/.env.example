# Copy this file to server/.env and fill it in. Never commit server/.env.
# Share these values privately, the secret key gives full access to the database.

SUPABASE_URL=https://your-project-ref.supabase.co
# Secret key (sb_secret_...) or legacy service_role key. Server only, never in the app.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxx

# AI for /api/ai: "openai" (ChatGPT) or "gemini". If unset: openai when OPENAI_API_KEY is set.
AI_PROVIDER=openai

# OpenAI key from https://platform.openai.com/api-keys (paid: add a few dollars of credit first)
OPENAI_API_KEY=
# Optional. Any model ID from https://platform.openai.com/docs/models
# OPENAI_MODEL=gpt-5.4-mini

# Free Gemini key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Change if Google retires the default model (see the model list in AI Studio).
# GEMINI_MODEL=gemini-3.8-flash
# Optional. A second model to try when the main one is overloaded. Pick one from the model list in AI Studio.
# GEMINI_FALLBACK_MODEL=

PORT=3000
