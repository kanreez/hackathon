# Copy this file to .env (same folder) and fill it in. Never commit .env.
# Values: Supabase dashboard → Project Settings → API / Data API

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) or legacy anon key. NEVER the secret/service_role key.
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx

# Optional. Leave unset in development: the app reaches the backend on your PC automatically.
# Set it when the backend is deployed somewhere, e.g. https://my-backend.onrender.com
# EXPO_PUBLIC_API_URL=

# Restart with `npx expo start -c` after changing this file.
